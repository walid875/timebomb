end)

connect(RunService.RenderStepped, function(dt)
	if not bombUtilEnabled then return end

	local character = LocalPlayer.Character
	if not character then return end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root then return end

	humanoid.WalkSpeed = SPEED

	local currentlyHolding = isHoldingTimeBomb()
	if currentlyHolding and not holdingBomb then
		holdingBomb = true
		equippedTime = os.clock()
		reactionTime = math.random(150, 350) / 1000
	elseif not currentlyHolding and holdingBomb then
		holdingBomb = false
		flipTime = 0
		humanoid.AutoRotate = true
	end

	if not holdingBomb or (os.clock() - equippedTime) < reactionTime then
		humanoid.AutoRotate = true
		flipTime = 0
		return
	end

	local target = getTarget()
	if not target or not target.Character then
		humanoid.AutoRotate = true
		flipTime = 0
		return
	end

	local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
	if not targetRoot then
		humanoid.AutoRotate = true
		flipTime = 0
		return
	end

	humanoid.AutoRotate = false

	local direction = Vector3.new(
		targetRoot.Position.X - root.Position.X,
		0,
		targetRoot.Position.Z - root.Position.Z
	)

	if direction.Magnitude < 0.01 then return end
	direction = direction.Unit

	flipTime += dt
	local flipAngle = math.sin(flipTime * FLIP_SPEED) * math.rad(FLIP_ANGLE)
	local lookAtTarget = CFrame.lookAt(root.Position, root.Position + direction)
	root.CFrame = lookAtTarget * CFrame.Angles(0, flipAngle, 0)
end)

--------------------------------------------------------------------------------
-- 5. PROFESSIONAL DRIBBLE (PREDICTIVE, ADAPTIVE & JITTER-FREE)
--------------------------------------------------------------------------------
local HIGH_SIZE = Vector3.new(2.5, 13, 2.5)
local AIM_BIND_NAME = "ProDribbleAimLock"

local DRIBBLE_CONFIG = {
	MaxRange = 14,
	FieldOfView = 140,
	MinSpeed = 16,
	MaxSpeed = 38,
	PredictionTime = 0.14,
	DeadzoneDegrees = 0.6,
	TargetHysteresis = 2.0
}

local activeDribbleTarget = nil

local function isTargetValid(pChar, root)
	if not pChar or not pChar:FindFirstChildOfClass("Tool") then return false end
	local pRoot = pChar:FindFirstChild("HumanoidRootPart")
	local pHum = pChar:FindFirstChildOfClass("Humanoid")
	if not pRoot or not pHum or pHum.Health <= 0 then return false end

	local offset = pRoot.Position - root.Position
	local dist = Vector3.new(offset.X, 0, offset.Z).Magnitude
	if dist > DRIBBLE_CONFIG.MaxRange then return false end

	local lookFlat = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z).Unit
	local dirFlat = Vector3.new(offset.X, 0, offset.Z).Unit
	local angle = math.deg(math.acos(math.clamp(lookFlat:Dot(dirFlat), -1, 1)))
	if angle > (DRIBBLE_CONFIG.FieldOfView * 0.5) then return false end

	return true, dist, pRoot
end

local function getBestDribbleTarget(root)
	if activeDribbleTarget and activeDribbleTarget.Parent then
		local valid, dist, pRoot = isTargetValid(activeDribbleTarget.Parent, root)
		if valid and dist <= (DRIBBLE_CONFIG.MaxRange + DRIBBLE_CONFIG.TargetHysteresis) then
			return pRoot
		end
	end

	local bestTarget = nil
	local lowestScore = math.huge

	for _, player in ipairs(Players:GetPlayers()) do
		if player == LocalPlayer then continue end
		local pChar = player.Character
		if not pChar then continue end

		local valid, dist, pRoot = isTargetValid(pChar, root)
		if valid then
			local relVel = pRoot.AssemblyLinearVelocity - root.AssemblyLinearVelocity
			local toMe = (root.Position - pRoot.Position).Unit
			local closingFactor = math.clamp(relVel:Dot(toMe) * 0.2, -3, 3)
			local score = dist - closingFactor

			if score < lowestScore then
				lowestScore = score
				bestTarget = pRoot
			end
		end
	end

	activeDribbleTarget = bestTarget
	return bestTarget
end

local function applyAdaptiveFacing(root, targetRoot, dt)
	local targetVel = targetRoot.AssemblyLinearVelocity
	local predictedPos = targetRoot.Position + Vector3.new(targetVel.X, 0, targetVel.Z) * DRIBBLE_CONFIG.PredictionTime

	local toTarget = predictedPos - root.Position
	local flatDir = Vector3.new(toTarget.X, 0, toTarget.Z)
	if flatDir.Magnitude < 0.2 then return end
	flatDir = flatDir.Unit

	local currentLook = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z).Unit
	local dotProduct = math.clamp(currentLook:Dot(flatDir), -1, 1)
	local angularError = math.deg(math.acos(dotProduct))

	if angularError <= DRIBBLE_CONFIG.DeadzoneDegrees then return end

	local turnProgress = math.clamp(angularError / 90, 0, 1)
	local currentSpeed = DRIBBLE_CONFIG.MinSpeed + (DRIBBLE_CONFIG.MaxSpeed - DRIBBLE_CONFIG.MinSpeed) * (turnProgress ^ 1.5)

	local desiredCFrame = CFrame.lookAt(root.Position, root.Position + flatDir)
	local alpha = 1 - math.exp(-currentSpeed * dt)
	root.CFrame = root.CFrame:Lerp(desiredCFrame, alpha)
end

connect(RunService.Heartbeat, function()
	if not easyDribbleEnabled then return end

	for _, player in ipairs(Players:GetPlayers()) do
		if player == LocalPlayer then continue end
		local char = player.Character
		if not char then continue end

		local root = char:FindFirstChild("HumanoidRootPart")
		if not root then continue end

		if not originalHighSizes[player] then
			originalHighSizes[player] = {
				Size = root.Size,
				CanCollide = root.CanCollide,
				Transparency = root.Transparency
			}
		end

		root.Size = HIGH_SIZE
		root.CanCollide = true
		root.Transparency = 0.85
	end
end)

local function startAimBinding()
	RunService:BindToRenderStep(AIM_BIND_NAME, Enum.RenderPriority.Character.Value + 1, function(dt)
		if not easyDribbleEnabled then return end

		local char = LocalPlayer.Character
		if not char then return end
		local hum = char:FindFirstChildOfClass("Humanoid")
		local root = char:FindFirstChild("HumanoidRootPart")
		if not hum or not root or hum.Health <= 0 then return end

		local state = hum:GetState()
		if state == Enum.HumanoidStateType.Physics or state == Enum.HumanoidStateType.Ragdoll or hum.Sit then
			return
		end

		local targetRoot = getBestDribbleTarget(root)

		if targetRoot then
			hum.AutoRotate = false

			pcall(function()
				UserGameSettings.RotationType = Enum.RotationType.MovementRelative
			end)

			applyAdaptiveFacing(root, targetRoot, dt)
		else
			activeDribbleTarget = nil
			hum.AutoRotate = true
		end
	end)
end

local function stopAimBinding()
	activeDribbleTarget = nil
	pcall(function()
		RunService:UnbindFromRenderStep(AIM_BIND_NAME)
	end)
end

