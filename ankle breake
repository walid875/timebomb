local OTHER_HITBOX_SIZE = Vector3.new(10, 10, 10)
local SPEED = 18
local MY_BOMB_RANGE = 10
local FLIP_ANGLE = 45
local FLIP_SPEED = 30
local ESP_COLOR = Color3.fromRGB(255, 255, 255)
local TIMEBOMB_NAMES = {"TimeBomb", "Timebomb", "timebomb"}

local function isHoldingTimeBomb()
	local character = LocalPlayer.Character
	if not character then return false end
	for _, name in ipairs(TIMEBOMB_NAMES) do
		if character:FindFirstChild(name) then return true end
	end
	return false
end

local function hasTimeBomb(player)
	local character = player.Character
	local backpack = player:FindFirstChild("Backpack")
	for _, name in ipairs(TIMEBOMB_NAMES) do
		if character and character:FindFirstChild(name) then return true end
		if backpack and backpack:FindFirstChild(name) then return true end
	end
	return false
end

local function getTarget()
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not hasTimeBomb(LocalPlayer) then return nil end

	local closestTarget, closestDistance = nil, MY_BOMB_RANGE
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
			if targetRoot then
				local distance = (root.Position - targetRoot.Position).Magnitude
				if distance <= closestDistance then
					closestDistance = distance
					closestTarget = player
				end
			end
		end
	end
	return closestTarget
end

local function addESP(player, character)
	if player == LocalPlayer or not bombUtilEnabled then return end
	local old = character:FindFirstChild("SimpleESP")
	if old then old:Destroy() end

	local highlight = Instance.new("Highlight")
	highlight.Name = "SimpleESP"
	highlight.Adornee = character
	highlight.FillColor = ESP_COLOR
	highlight.OutlineColor = ESP_COLOR
	highlight.FillTransparency = 0.75
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = character
end

local function removeESP(player)
	if player.Character then
		local esp = player.Character:FindFirstChild("SimpleESP")
		if esp then esp:Destroy() end
	end
end

local function setupPlayer(player)
	if player == LocalPlayer then return end
	if player.Character then
		addESP(player, player.Character)
	end
	local conn = player.CharacterAdded:Connect(function(character)
		task.wait(0.15)
		if bombUtilEnabled then
			addESP(player, character)
		end
		originalHitboxSizes[player] = nil
	end)
	table.insert(espConnections, conn)
end

connect(RunService.Heartbeat, function()
	if not bombUtilEnabled then return end
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local root = player.Character:FindFirstChild("HumanoidRootPart")
			if root then
				if not originalHitboxSizes[player] then
					originalHitboxSizes[player] = {
