--------------------------------------------------------------------------------
-- HELPERS
--------------------------------------------------------------------------------
local function connect(signal, callback)
	local conn = signal:Connect(callback)
	table.insert(connections, conn)
	return conn
end

local function clearEspConnections()
	for _, conn in ipairs(espConnections) do
		if conn.Connected then
			conn:Disconnect()
		end
	end
	table.clear(espConnections)
end

local function restoreHitboxes()
	for player, original in pairs(originalHitboxSizes) do
		if player and player.Character then
			local root = player.Character:FindFirstChild("HumanoidRootPart")
			if root then
				root.Size = original.Size
				root.CanCollide = original.CanCollide
				root.Transparency = original.Transparency
			end
		end
	end
	table.clear(originalHitboxSizes)
end

local function restoreHighSizes()
	for player, original in pairs(originalHighSizes) do
		if player and player.Character then
			local root = player.Character:FindFirstChild("HumanoidRootPart")
			if root then
				root.Size = original.Size
				root.CanCollide = original.CanCollide
				root.Transparency = original.Transparency
			end
		end
	end
	table.clear(originalHighSizes)
end

local function restoreLighting()
	if lightingBackup then
		Lighting.GlobalShadows = lightingBackup.GlobalShadows
		for effect, enabled in pairs(lightingBackup.Effects) do
			if effect and effect.Parent then
				effect.Enabled = enabled
			end
		end
		lightingBackup = nil
	end
end

local function restoreHumanoid()
	local char = LocalPlayer.Character
	if char and savedHumanoidState then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.WalkSpeed = savedHumanoidState.WalkSpeed
			hum.AutoRotate = savedHumanoidState.AutoRotate
		end
	end
	savedHumanoidState = nil
end

