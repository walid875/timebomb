        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and dragStart and startPosition
        and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPosition.X.Scale, startPosition.X.Offset + delta.X,
            startPosition.Y.Scale, startPosition.Y.Offset + delta.Y
        )
        shadow.Position = UDim2.new(
            main.Position.X.Scale, main.Position.X.Offset + 4,
            main.Position.Y.Scale, main.Position.Y.Offset + 5
        )
    end
end)

-- Targeting and following
local tracking = false
local lockedTarget = nil
local pathBusy = false
local lastPathAt = 0
local runToken = 0
local lastDistanceUpdate = 0

local function hasTimebomb()
    local function hasIn(container)
        if not container then return false end
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("Tool") and string.lower(child.Name) == "timebomb" then
                return true
            end
        end
        return false
    end
    return hasIn(localPlayer.Character) or hasIn(localPlayer:FindFirstChildOfClass("Backpack"))
end

local function getAliveCharacter(player)
    if not player then return nil, nil, nil end
    local character = player.Character
    if not character then return nil, nil, nil end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or humanoid.Health <= 0 or not root then
        return character, humanoid, nil
    end
    return character, humanoid, root
end

local function nearestPlayer()
    local _, _, myRoot = getAliveCharacter(localPlayer)
    if not myRoot then return nil end
    local closest = nil
    local closestDistance = math.huge
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= localPlayer then
            local _, _, otherRoot = getAliveCharacter(other)
            if otherRoot then
                local distance = (myRoot.Position - otherRoot.Position).Magnitude
                if distance < closestDistance then
                    closestDistance = distance
                    closest = other
                end
            end
        end
    end
    return closest
end

local function setStatus(title, hint, color)
    statusText.Text = title
    statusHint.Text = hint
    statusDot.BackgroundColor3 = color
end

local function setToolStatus()
    if hasTimebomb() then
        toolText.Text = "TIMEBOMB  •  READY"
        toolDot.BackgroundColor3 = C.green
    else
        toolText.Text = "TIMEBOMB  •  NOT FOUND"
        toolDot.BackgroundColor3 = C.red
    end
end

local function softStop()
    local _, humanoid, root = getAliveCharacter(localPlayer)
    if humanoid and root then
        humanoid:MoveTo(root.Position)
    end
end

local function releaseLock(reason)
    tracking = false
    lockedTarget = nil
    runToken += 1
    softStop()
    targetName.Text = "No target selected"
    toggleButton.Text = "LOCK NEAREST  →"
    toggleButton.BackgroundColor3 = C.accent
    setToolStatus()
    if reason == "tool" then
        setStatus("TOOL LOST", "Following stopped • target released", C.red)
    elseif reason == "manual" then
        setStatus("STANDBY", "Target lock released", C.yellow)
    else
        setStatus("STANDBY", "Waiting for activation", C.yellow)
    end
end

local function destinationNearTarget(targetRoot, myRoot)
    local offset = myRoot.Position - targetRoot.Position
    if offset.Magnitude < 0.05 then
        offset = Vector3.new(1, 0, 0)
    end
    -- Stop a few studs away instead of trying to occupy the target's exact position.
    return targetRoot.Position + offset.Unit * 3.2
end

local function requestPath(targetPlayer, token)
    if pathBusy or not tracking or not hasTimebomb() then return end
    if os.clock() - lastPathAt < 0.55 then return end

    local ownCharacter, ownHumanoid, ownRoot = getAliveCharacter(localPlayer)
    local targetCharacter, _, targetRoot = getAliveCharacter(targetPlayer)
    if not ownCharacter or not ownHumanoid or not ownRoot or not targetCharacter or not targetRoot then
        return
    end

    local destination = destinationNearTarget(targetRoot, ownRoot)
    pathBusy = true
    lastPathAt = os.clock()

    task.spawn(function()
        local computedPath = nil
        local ok = pcall(function()
            local path = PathfindingService:CreatePath({
                AgentRadius = 2,
                AgentHeight = 5,
                AgentCanJump = true,
                AgentCanClimb = true,
                WaypointSpacing = 4,
            })
            path:ComputeAsync(ownRoot.Position, destination)
            if path.Status == Enum.PathStatus.Success then
                computedPath = path
            end
        end)

        -- Re-check every condition after ComputeAsync, which yields.
        if tracking and hasTimebomb() and runToken == token
            and lockedTarget == targetPlayer and localPlayer.Character == ownCharacter then
            local currentTargetCharacter, _, currentTargetRoot = getAliveCharacter(targetPlayer)
            local currentOwnCharacter, currentOwnHumanoid, currentOwnRoot = getAliveCharacter(localPlayer)
            if currentTargetCharacter == targetCharacter and currentTargetRoot
                and currentOwnCharacter == ownCharacter and currentOwnHumanoid and currentOwnRoot then
                if ok and computedPath then
                    local waypoints = computedPath:GetWaypoints()
                    local waypoint = waypoints[2] or waypoints[1]
                    if waypoint then
                        if waypoint.Action == Enum.PathWaypointAction.Jump then
                            currentOwnHumanoid.Jump = true
                        end
                        currentOwnHumanoid:MoveTo(waypoint.Position)
                    else
                        currentOwnHumanoid:MoveTo(destinationNearTarget(currentTargetRoot, currentOwnRoot))
                    end
                else
                    -- Simple fallback when pathfinding cannot find a route.
                    currentOwnHumanoid:MoveTo(destinationNearTarget(currentTargetRoot, currentOwnRoot))
                end
            end
        end
        pathBusy = false
    end)
end

local function beginLock()
    if not hasTimebomb() then
        setToolStatus()
        setStatus("TOOL REQUIRED", "Equip a Tool named Timebomb first", C.red)
        return
    end

    local target = nearestPlayer()
    if not target then
        setStatus("NO TARGET", "No other living player was found", C.yellow)
        return
    end

    lockedTarget = target
    tracking = true
    runToken += 1
    lastPathAt = 0
    targetName.Text = target.DisplayName .. "  (@" .. target.Name .. ")"
    toggleButton.Text = "RELEASE TARGET  ×"
    toggleButton.BackgroundColor3 = C.red
    setToolStatus()
    setStatus("TARGET LOCKED", "Following the first selected player", C.green)
end

toggleButton.MouseEnter:Connect(function()
    if tracking then return end
    TweenService:Create(toggleButton, TweenInfo.new(0.16), { BackgroundColor3 = Color3.fromRGB(121, 130, 255) }):Play()
end)
toggleButton.MouseLeave:Connect(function()
    if tracking then return end
    TweenService:Create(toggleButton, TweenInfo.new(0.16), { BackgroundColor3 = C.accent }):Play()
end)
toggleButton.Activated:Connect(function()
    if tracking then
        releaseLock("manual")
    else
        beginLock()
    end
end)

-- Main monitor: never chooses a replacement target while a lock is active.
task.spawn(function()
    while gui.Parent do
        task.wait(0.16)
        setToolStatus()

        if tracking then
            if not hasTimebomb() then
                releaseLock("tool")
            elseif not lockedTarget then
                releaseLock("manual")
            else
                local _, _, myRoot = getAliveCharacter(localPlayer)
                local _, _, targetRoot = getAliveCharacter(lockedTarget)

                if not myRoot then
                    setStatus("WAITING FOR YOU", "Waiting for your character to respawn", C.yellow)
                elseif not targetRoot then
                    -- Keep the same player locked; never choose someone else as a replacement.
                    setStatus("TARGET UNAVAILABLE", "Still locked • waiting for that player", C.yellow)
                else
                    local distance = (myRoot.Position - targetRoot.Position).Magnitude
                    if distance <= 4.5 then
                        setStatus("IN RANGE", "Locked target • staying close", C.green)
                    else
                        setStatus("FOLLOWING TARGET", "Locked • " .. tostring(math.floor(distance)) .. " studs away", C.green)
                    end
                    if os.clock() - lastDistanceUpdate >= 0.5 then
                        lastDistanceUpdate = os.clock()
                        requestPath(lockedTarget, runToken)
                    end
                end
            end
        end
    end
end)

setToolStatus()
setStatus("STANDBY", "Equip Timebomb, then lock nearest", C.yellow)
